-- the definition of the samples tables
id	Tuple(UInt64, LowCardinality(UUID))	
samples	SimpleAggregateFunction(timeSeriesGroupArray, Array(Tuple(timestamp DateTime64(3), value Float64)))	CODEC(ZSTD(3))
bucket	DateTime64(3)	
min_time	SimpleAggregateFunction(min, DateTime64(3))	
max_time	SimpleAggregateFunction(max, DateTime64(3))	
AggregatingMergeTree PARTITION BY toYYYYMM(bucket) ORDER BY (id, bucket) SETTINGS index_granularity = 1024, index_granularity_bytes = 1048576, allow_dimensions_outside_sorting_key = 1
samples_bucket_step_seconds = 600, recent_samples_ttl_seconds = 0, version = 2
-- the inserted samples are sorted, deduplicated (the greatest value wins, NaN loses) and split into buckets
dev	1970-01-01 00:00:00.000	[('1970-01-01 00:00:50.000',10)]	1970-01-01 00:00:50.000	1970-01-01 00:00:50.000
prod	1970-01-01 00:00:00.000	[('1970-01-01 00:01:40.000',2)]	1970-01-01 00:01:40.000	1970-01-01 00:01:40.000
prod	1970-01-01 00:10:00.000	[('1970-01-01 00:11:40.000',3),('1970-01-01 00:19:59.999',4)]	1970-01-01 00:11:40.000	1970-01-01 00:19:59.999
prod	1970-01-01 00:20:00.000	[('1970-01-01 00:20:50.000',5)]	1970-01-01 00:20:50.000	1970-01-01 00:20:50.000
-- reading the TimeSeries table returns a row per bucket, the rows of a series can be merged with timeSeriesGroupArray
m	{'__name__':'m','env':'dev'}	[('1970-01-01 00:00:50.000',10)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:01:40.000',2)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:11:40.000',3),('1970-01-01 00:19:59.999',4)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:20:50.000',5)]
m	{'__name__':'m','env':'dev'}	[('1970-01-01 00:00:50.000',10)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:01:40.000',2),('1970-01-01 00:11:40.000',3),('1970-01-01 00:19:59.999',4),('1970-01-01 00:20:50.000',5)]
-- the rows of the same bucket are merged by the engine
5
-- without FINAL the rows of the unmerged parts are returned as they are, with FINAL the rows of the same bucket are merged
m	{'__name__':'m','env':'dev'}	[('1970-01-01 00:00:50.000',10)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:01:40.000',1),('1970-01-01 00:02:30.000',1.5)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:01:40.000',2)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:11:40.000',3),('1970-01-01 00:19:59.999',4)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:20:50.000',5)]
m	{'__name__':'m','env':'dev'}	[('1970-01-01 00:00:50.000',10)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:01:40.000',2),('1970-01-01 00:02:30.000',1.5)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:11:40.000',3),('1970-01-01 00:19:59.999',4)]
m	{'__name__':'m','env':'prod'}	[('1970-01-01 00:20:50.000',5)]
4
dev	1970-01-01 00:00:00.000	[('1970-01-01 00:00:50.000',10)]	1970-01-01 00:00:50.000	1970-01-01 00:00:50.000
prod	1970-01-01 00:00:00.000	[('1970-01-01 00:01:40.000',2),('1970-01-01 00:02:30.000',1.5)]	1970-01-01 00:01:40.000	1970-01-01 00:02:30.000
-- timeSeriesSelector returns the buckets cut to the requested interval, the rows of a series can be merged with timeSeriesGroupArray
id	Tuple(UInt64, LowCardinality(UUID))					
time_series	Array(Tuple(DateTime64(3), Float64))					
[('1970-01-01 00:02:30.000',1.5)]
[('1970-01-01 00:11:40.000',3),('1970-01-01 00:19:59.999',4)]
[('1970-01-01 00:02:30.000',1.5),('1970-01-01 00:11:40.000',3),('1970-01-01 00:19:59.999',4)]
