-- PromQL over the buckets
[('__name__','m'),('env','prod')]	1970-01-01 00:21:40.000	5
[('env','dev')]	[('1970-01-01 00:10:00.000',10)]
[('env','prod')]	[('1970-01-01 00:10:00.000',3.5),('1970-01-01 00:15:50.000',3),('1970-01-01 00:21:40.000',9)]
[('env','dev')]	[('1970-01-01 00:10:00.000',1),('1970-01-01 00:15:50.000',1)]
