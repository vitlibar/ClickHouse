-- the bucket steps are validated and cannot be altered
-- the columns of the older layout are rejected
-- the types of timestamps and values can be adjusted via the outer column or via the samples column
`id` Tuple(UInt64, LowCardinality(UUID)), `samples` SimpleAggregateFunction(timeSeriesGroupArray, Array(Tuple(timestamp UInt32, value Float32))) CODEC(ZSTD(3)), `bucket` UInt32, `min_time` SimpleAggregateFunction(min, UInt32), `max_time` SimpleAggregateFunction(max, UInt32)
[(50,2.5),(100,1.5)]
0	[(50,2.5),(100,1.5)]	50	100
id	time_series
Tuple(UInt64, LowCardinality(UUID))	Array(Tuple(UInt32, Float32))
