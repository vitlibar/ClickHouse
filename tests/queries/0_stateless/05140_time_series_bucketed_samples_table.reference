-- an external samples table can use plain types
1970-01-01 00:00:00.000	[('1970-01-01 00:01:40.000',2)]	1970-01-01 00:01:40.000	1970-01-01 00:01:40.000
1970-01-01 01:00:00.000	[('1970-01-01 01:06:40.000',1)]	1970-01-01 01:06:40.000	1970-01-01 01:06:40.000
