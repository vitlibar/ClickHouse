[('__name__','m'),('env','prod')]	1970-01-01 00:21:40.000	3
[('__name__','m'),('env','dev')]	[('1970-01-01 00:00:50.000',10)]
[('__name__','m'),('env','prod')]	[('1970-01-01 00:01:40.000',2),('1970-01-01 00:02:30.000',1.5),('1970-01-01 00:11:40.000',3),('1970-01-01 00:19:59.999',4),('1970-01-01 00:20:50.000',5)]
-- the recent samples table has its own bucket step
recent_samples_ttl_seconds = 864000, recent_samples_bucket_step_seconds = 300, version = 2, samples_bucket_step_seconds = 3600
AggregatingMergeTree PARTITION BY toStartOfInterval(bucket, toIntervalHour(5)) ORDER BY (id, bucket) TTL bucket + toIntervalSecond(864300) SETTINGS index_granularity = 1024, index_granularity_bytes = 1048576, allow_dimensions_outside_sorting_key = 1, ttl_only_drop_parts = 1
12	1	0	0	0
