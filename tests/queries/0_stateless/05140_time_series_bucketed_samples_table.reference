-- an external samples table of a wrong layout is rejected
-- a table created AS a table of an older version gets the new layout with the same types
`id` Tuple(UInt64, LowCardinality(UUID)), `timestamp` DateTime64(6) CODEC(Delta, ZSTD), `value` Float32	MergeTree ORDER BY (id, timestamp) SETTINGS index_granularity = 1024, index_granularity_bytes = 1048576
2	`id` Tuple(UInt64, LowCardinality(UUID)), `samples` SimpleAggregateFunction(timeSeriesGroupArray, Array(Tuple(timestamp DateTime64(6), value Float32))) CODEC(ZSTD(3)), `bucket` DateTime64(6), `min_time` SimpleAggregateFunction(min, DateTime64(6)), `max_time` SimpleAggregateFunction(max, DateTime64(6))	AggregatingMergeTree PARTITION BY toYYYYMM(bucket) ORDER BY (id, bucket) SETTINGS index_granularity = 1024, index_granularity_bytes = 1048576, allow_dimensions_outside_sorting_key = 1
-- the all_tags column of version 0 cannot be used by id generators
0	`id` UUID DEFAULT reinterpretAsUUID(sipHash128(tags))
